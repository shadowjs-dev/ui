{
  "name": "@shadow-js/ui",
  "version": "1.0.1",
  "description": "shadcn-style components you add to your project with a CLI, styled with Tailwind v4",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/cli.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "shadow-ui": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "registry",
    "registry.json",
    "styles",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./locales/en": {
      "types": "./dist/dev/locales/en.d.ts",
      "development": "./dist/dev/locales/en.js",
      "default": "./dist/prod/locales/en.js"
    },
    "./locales/ar": {
      "types": "./dist/dev/locales/ar.d.ts",
      "development": "./dist/dev/locales/ar.js",
      "default": "./dist/prod/locales/ar.js"
    },
    "./theme.css": "./styles/theme.css",
    "./animations.css": "./styles/animations.css",
    "./typeset.css": "./styles/typeset.css",
    "./themes/*.css": "./styles/themes/*.css",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.registry.json && npm run typecheck:types",
    "typecheck:types": "tsc -p tsconfig.test-types.json",
    "lint": "biome check .",
    "test": "vitest run --project unit --project dom --project server",
    "test:gc": "vitest run --project gc --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:perf && npm run test:gc"
  },
  "peerDependencies": {
    "@shadow-js/core": "^1.0.1",
    "@shadow-js/primitives": "^1.0.1",
    "@shadow-js/web": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@shadow-js/compiler": "^1.0.1",
    "@shadow-js/core": "^1.0.1",
    "@shadow-js/forms": "^1.0.1",
    "@shadow-js/primitives": "^1.0.1",
    "@shadow-js/testing": "^1.0.1",
    "@shadow-js/web": "^1.0.1",
    "@tailwindcss/node": "4.3.3",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "oxc-parser": "0.153.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@shadow-js/table": "1.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "homepage": "https://ui.shadowjs.net",
  "keywords": [
    "shadowjs",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowjs-dev/ui.git"
  },
  "bugs": {
    "url": "https://github.com/shadowjs-dev/ui/issues"
  }
}
