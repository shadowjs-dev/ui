{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/fixtures",
      "!**/.generated",
      "!registry.json",
      "!tsconfig.registry.json",
      "!dist"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noImportantStyles": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["**/test-types/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useAltText": "off",
            "useMediaCaption": "off",
            "noAmbiguousAnchorText": "off",
            "noSvgWithoutTitle": "off",
            "useValidAnchor": "off",
            "useAnchorContent": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["registry/**", "test/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noSvgWithoutTitle": "off",
            "useAnchorContent": "off",
            "useHeadingContent": "off",
            "useButtonType": "off",
            "useAltText": "off",
            "useSemanticElements": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "noNoninteractiveElementInteractions": "off",
            "noNoninteractiveTabindex": "off",
            "noRedundantRoles": "off",
            "useFocusableInteractive": "off",
            "useValidAnchor": "off",
            "useMediaCaption": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
